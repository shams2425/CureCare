
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CureCare</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg cc-navbar">
            <div class="container">
                

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 cc-nav-links">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                           

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Patients"
                                       asp-action="Index">
                                        Manage Patients
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Home
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center cc-account-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="cc-welcome">
                                   @User.Identity.Name
                                </span>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <span class="cc-admin-badge">Admin</span>
                                </li>
                            }

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="cc-logout-btn">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="cc-login-btn"
                                   asp-controller="Account"
                                   asp-action="AdminLogin">
                                    Admin Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="cc-register-btn"
                                   asp-controller="Account"
                                   asp-action="RegisterAdmin">
                                    Admin Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container cc-main-container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="cc-footer">
        <div class="container d-flex flex-column flex-sm-row
            justify-content-between align-items-center gap-2">
            <span class="cc-footer-brand">+ CureCare</span>
            <span>&copy; @DateTime.Now.Year CureCare. All rights reserved.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
