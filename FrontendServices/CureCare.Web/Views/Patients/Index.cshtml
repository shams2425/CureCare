
@model IEnumerable<PatientResponseViewModel>

@{
    ViewData["Title"] = "Patients";
}

<div class="patients-page">

    <div class="patients-page-header">
        <div>
            <span class="patients-eyebrow">PATIENT MANAGEMENT</span>
            <h1>Patients</h1>
            <p>View and manage registered patient records.</p>
        </div>

        <a asp-controller="Patients"
           asp-action="Create"
           class="btn btn-primary patients-add-btn">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="19" height="19" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Register Patient
        </a>
    </div>

    <section class="patients-list-card">

        <div class="patients-list-heading">
            <div>
                <h2>Registered Patients</h2>
                <p>Patient information and available actions.</p>
            </div>
        </div>

        <div class="patients-search-area">
            <label for="patientSearch" class="visually-hidden">
                Search patients
            </label>

            <div class="patients-search-box">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.35-4.35" />
                </svg>

                <input type="search"
                       id="patientSearch"
                       class="form-control"
                       placeholder="Search by name, phone, blood group..."
                       autocomplete="off" />
            </div>

            <span id="patientSearchCount" class="patients-search-count"></span>
        </div>

        <div class="table-responsive patients-table-wrapper">
            <table class="table table-hover patients-table">
                <thead>
                    <tr>
                        <th>Patient Name</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Blood Group</th>
                        <th>Phone Number</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody id="patientsTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var patient in Model)
                        {
                            <tr class="patient-row">
                                <td>
                                    <div class="patient-name-cell">
                                        <span class="patient-avatar" aria-hidden="true">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 width="20" height="20"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <circle cx="12" cy="8" r="4" />
                                                <path d="M5 21v-2a7 7 0 0 1 14 0v2" />
                                            </svg>
                                        </span>

                                        <span class="patient-name-text">
                                            @patient.FullName
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @patient.DateOfBirth.ToString("dd MMM yyyy")
                                </td>

                                <td>@patient.Gender</td>

                                <td>
                                    <span class="blood-group-badge">
                                        @patient.BloodGroup
                                    </span>
                                </td>

                                <td>@patient.PhoneNumber</td>

                                <td>
                                    <div class="patient-actions">

                                        <a asp-controller="Patients"
                                           asp-action="Details"
                                           asp-route-id="@patient.Id"
                                           class="action-icon view-icon"
                                           title="View details"
                                           aria-label="View patient details">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 width="18" height="18"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        </a>

                                        <a asp-controller="Patients"
                                           asp-action="Edit"
                                           asp-route-id="@patient.Id"
                                           class="action-icon edit-icon"
                                           title="Edit patient"
                                           aria-label="Edit patient">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 width="18" height="18"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                            </svg>
                                        </a>

                                        <a asp-controller="Patients"
                                           asp-action="Delete"
                                           asp-route-id="@patient.Id"
                                           class="action-icon delete-icon"
                                           title="Delete patient"
                                           aria-label="Delete patient">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 width="18" height="18"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <path d="M3 6h18" />
                                                <path d="M8 6V4h8v2" />
                                                <path d="m19 6-1 14H6L5 6" />
                                                <path d="M10 11v5M14 11v5" />
                                            </svg>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="patients-empty-state">
                                    <div class="patients-empty-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="36" height="36"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.5"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                            <circle cx="10" cy="7" r="4" />
                                            <path d="M19 8v6M22 11h-6" />
                                        </svg>
                                    </div>

                                    <h3>No patients registered yet</h3>
                                    <p>Register your first patient to get started.</p>

                                    <a asp-controller="Patients"
                                       asp-action="Create"
                                       class="btn btn-primary">
                                        Register First Patient
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                    <tr id="noSearchResults" class="d-none">
                        <td colspan="6">
                            <div class="patients-empty-state">
                                <h3>No matching patients found</h3>
                                <p>Try another name, phone number or blood group.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="patients-list-footer">
            <span>Patient records are displayed from CureCare.</span>
        </div>

    </section>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("patientSearch");

            const patientRows = Array.from(
                document.querySelectorAll("#patientsTableBody .patient-row")
            );

            const noResults = document.getElementById("noSearchResults");
            const countLabel = document.getElementById("patientSearchCount");

            function updatePatientSearch() {
                const query = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;

                patientRows.forEach(function (row) {
                    const matches = row.textContent.toLowerCase().includes(query);

                    row.classList.toggle("d-none", !matches);

                    if (matches) {
                        visibleCount++;
                    }
                });

                noResults.classList.toggle(
                    "d-none",
                    patientRows.length === 0 ||
                    visibleCount > 0 ||
                    query.length === 0
                );

                countLabel.textContent = query
                    ? visibleCount + " matching patient(s)"
                    : patientRows.length + " patient(s)";
            }

            searchInput.addEventListener("input", updatePatientSearch);
            updatePatientSearch();
        });
    </script>
}
