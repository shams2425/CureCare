
@{
    ViewData["Title"] = "Home";
}

<div class="cc-home-page">

    <section class="cc-home-welcome">
        <p class="cc-home-label">CURECARE HOSPITAL</p>

        <h1>Welcome, @User.Identity?.Name</h1>

        <p class="cc-home-subtitle">
            Your health and well-being are our priority.
        </p>
    </section>

    <section class="cc-user-details">
        <h2>Your Details</h2>

        <div class="cc-detail-row">
            <span>Name</span>
            <strong>@User.Identity?.Name</strong>
        </div>

        <div class="cc-detail-row">
            <span>Account Type</span>
            <strong>
                @(User.IsInRole("Admin") ? "Admin" : "User")
            </strong>
        </div>
    </section>

    <section class="cc-hospital-info">
        <h2>About CureCare</h2>

        <p>
            CureCare is dedicated to providing quality healthcare
            through patient-focused services, organised medical records,
            and a reliable hospital management system.
        </p>
    </section>

    <div class="cc-home-action" >
        <a asp-controller="Patients"
           asp-action="Create"
           class="cc-register-patient-btn">
            Register Patient
        </a>
    </div>

</div>
